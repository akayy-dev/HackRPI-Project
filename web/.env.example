# --- Data source ---
# Leave empty to use hard-coded mock data (src/lib/data/mock.ts)
MONGODB_URI=
MONGODB_DB=proxy
# Collection holding request logs
MONGODB_COLLECTION=connections

# --- Geo-IP (country level) ---
# Path to the DB-IP country .mmdb (npm run geoip:download)
GEOIP_DB_PATH=data/dbip-country-lite.mmdb
# true only if the proxy is behind a CDN/load balancer you control (trusts X-Forwarded-For etc.)
TRUST_PROXY_HEADERS=false

# --- AI SOC analyst (Grok) ---
# grok (gemini: not implemented yet). Leave empty for the rule-based heuristic analyst.
AI_PROVIDER=
XAI_API_KEY=
XAI_MODEL=grok-4
# Seconds a triage result is reused before Grok is asked again
AI_TRIAGE_TTL_SEC=60
GEMINI_API_KEY=

# --- SOC alerts ---
# Seconds between watcher checks (cheap, no AI). Grok is only called when severity rises. 0 disables.
AI_WATCH_INTERVAL_SEC=30
# Optional Slack or Discord incoming-webhook URL for alerts
ALERT_WEBHOOK_URL=
