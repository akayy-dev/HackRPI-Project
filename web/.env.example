# --- Data source ---
# Leave empty to use hard-coded mock data (src/lib/data/mock.ts)
MONGODB_URI=
MONGODB_DB=proxy
# Collection holding request logs
MONGODB_COLLECTION=connections

# --- Geo-IP (country level) ---
# Path to the DB-IP country .mmdb (npm run geoip:download)
GEOIP_DB_PATH=data/dbip-country-lite.mmdb
# true only if the proxy is behind a CDN/load balancer you control (trusts X-Forwarded-For etc.)
TRUST_PROXY_HEADERS=false

# --- AI assistant (not implemented yet) ---
# grok | gemini
AI_PROVIDER=
XAI_API_KEY=
GEMINI_API_KEY=
